{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Glimpse",
  "colors": {
    "primary": "#0A0A0E",
    "light": "#FFFFFF",
    "dark": "#0A0A0E"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Glimpse App",
          "icon": "chart-line",
          "href": "https://www.glimpse.markets"
        },
        {
          "anchor": "X",
          "icon": "x-twitter",
          "href": "https://x.com/GlimpseMarkets"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "API Reference",
        "icon": "code",
        "pages": [
          "api-reference/introduction",
          "api-reference/auth",
          "api-reference/markets-topics",
          "api-reference/trading",
          "api-reference/portfolio",
          {
            "group": "N-Market Public",
            "icon": "globe",
            "pages": [
              "api-reference/nmarket/batches",
              "api-reference/nmarket/active-markets",
              "api-reference/nmarket/markets",
              "api-reference/nmarket/batch-stats",
              "api-reference/nmarket/ended-by-batch",
              "api-reference/nmarket/ended-past-168h",
              "api-reference/nmarket/markets-list",
              "api-reference/nmarket/market-quotes",
              "api-reference/nmarket/market-stats",
              "api-reference/nmarket/market-volume",
              "api-reference/nmarket/resolved-past-168h",
              "api-reference/nmarket/active-markets-v2",
              "api-reference/nmarket/resolved-markets-v2",
              "api-reference/nmarket/untitled-page",
              "api-reference/nmarket/untitled-page-1",
              "api-reference/nmarket/untitled-page-2",
              "api-reference/nmarket/untitled-page-3",
              "api-reference/nmarket/ee",
              "api-reference/nmarket/untitled-page-4",
              "api-reference/nmarket/untitled-page-5"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/Glimpse_Logo_07_Horizontal_All-Dark.svg",
    "dark": "/logo/Glimpse_Logo_07_Horizontal_All-White.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://www.glimpse.markets",
        "label": "Website"
      },
      {
        "href": "https://x.com/GlimpseMarkets",
        "label": "X"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://www.glimpse.markets/forecast"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/GlimpseMarkets"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0E"
    }
  }
}
